[11.149668455123901,"o","\u001b[m"]
[11.167642831802368,"o","\r\n"]
[11.282539129257202,"o","\n ***База данных***"]
[11.282590389251709,"o","\r"]
[11.282609224319458,"o","\n"]
[11.282638549804688,"o","\n***Процесс работы с таблицей***\r"]
[11.28268313407898,"o","\nФункции:\r"]
[11.282715320587158,"o","\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r"]
[11.282762050628662,"o","\n<command> list_tables - показать список всех таблиц\r"]
[11.28280520439148,"o","\n<command> drop_table <имя_таблицы> - удалить таблицу\r"]
[11.282855749130249,"o","\n<command> insert into <имя_таблицы> values (значение1, значение2) - добавить запись\r"]
[11.282902240753174,"o","\n<command> select from <имя_таблицы> - прочитать все записи\r"]
[11.282946348190308,"o","\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать по условию\r"]
[11.282990217208862,"o","\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить\r"]
[11.283031940460205,"o","\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить\r"]
[11.283068418502808,"o","\n<command> info <имя_таблицы> - вывести информацию о таблице\r"]
[11.283116817474365,"o","\n"]
[11.28314757347107,"o","\nОбщие команды:\r"]
[11.283192157745361,"o","\n<command> exit - выход из программы\r"]
[11.283228158950806,"o","\n<command> help - справочная информация\r"]
[11.283262729644775,"o","\n"]
[11.293300867080688,"o","\nВведите команду:\u001b[1C"]
[15.215413093566895,"o","c"]
[15.223641395568848,"o","reate_table users name:str age:int is_active:bool"]
[15.821379899978638,"o","\r"]
[15.821428537368774,"o","\n"]
[15.822321891784668,"o","Таблица users создана\r"]
[15.835312128067017,"o","\nВведите команду:\u001b[1C"]
[18.81367325782776,"o","i"]
[18.823046445846558,"o","nsert into users values (\"Sergei\", 28, true)"]
[19.813190937042236,"o","\r"]
[19.813233137130737,"o","\n"]
[19.815096139907837,"o","Запись с ID=1 успешно добавлена в таблицу \"users\".\r"]
[19.835707426071167,"o","\nВведите команду:\u001b[1C"]
[26.298468828201294,"o","i"]
[26.314505338668823,"o","nsert into users values (\"Anna\", 22, false)"]
[26.893107891082764,"o","\r"]
[26.89315366744995,"o","\n"]
[26.89413022994995,"o","Запись с ID=2 успешно добавлена в таблицу \"users\".\r"]
[26.91277766227722,"o","\nВведите команду:\u001b[1C"]
[29.782078504562378,"o","s"]
[29.8025119304657,"o","elect from users"]
[30.2451388835907,"o","\r"]
[30.24518132209778,"o","\n"]
[30.284992694854736,"o","+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  22 |   False   |\r"]
[30.285090684890747,"o","\n+----+--------+-----+-----------+"]
[30.285120964050293,"o","\r"]
[30.301331520080566,"o","\nВведите команду:\u001b[1C"]
[33.446216344833374,"o","s"]
[33.45692992210388,"o","elect from users where age = 28"]
[34.10901427268982,"o","\r"]
[34.109047651290894,"o","\n"]
[34.109742403030396,"o","+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r"]
[34.109798192977905,"o","\n+----+--------+-----+-----------+\r"]
[34.12870240211487,"o","\nВведите команду:\u001b[1C"]
[36.89696931838989,"o","u"]
[36.906657457351685,"o","pdate users set age = 29 where name = \"Sergei\""]
[37.45282769203186,"o","\r"]
[37.452876329422,"o","\n"]
[37.45378232002258,"o","Запись в таблице \"users\" успешно обновлена.\r"]
