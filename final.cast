[9.051992416381836,"o","\u001b[?25l\u001b[8;1H***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> insert into <имя_таблицы> values (значение1, значение2) - добавить запись\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать по условию\r\u001b[?25h"]
[9.052044153213501,"o","\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить\r"]
[9.052070379257202,"o","\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить\r"]
[9.052128076553345,"o","\n<command> info <имя_таблицы> - вывести информацию о таблице\r"]
[9.052152156829834,"o","\n"]
