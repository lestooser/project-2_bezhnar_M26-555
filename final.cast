[4.014165163040161,"o","\r\n ***База данных***"]
[4.01442551612854,"o","\u001b[?25l\u001b[8;1H***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> insert into <имя_таблицы> values (значение1, значение2) - добавить запись\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать по условию\r\u001b[?25h"]
[4.014474153518677,"o","\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить\r"]
[4.014515161514282,"o","\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить\r"]
[4.014568328857422,"o","\n<command> info <имя_таблицы> - вывести информацию о таблице\r"]
[4.0146074295043945,"o","\n"]
[4.01464056968689,"o","\nОбщие команды:\r"]
[4.014692544937134,"o","\n<command> exit - выход из программы\r"]
[4.0147387981414795,"o","\n<command> help - справочная информация\r"]
[4.0147905349731445,"o","\n"]
[4.0269951820373535,"o","\nВведите команду:\u001b[1C"]
